# ==============================================================================
# demo_milk_4dataset.milk - Interactive 4-Dataset Pipeline in Milk (bash-engine)
#
# Usage:
#   milk-script demo_milk_4dataset.milk
#   or inside milk-cli:
#   @source demo_milk_4dataset.milk
#
# Prerequisites:
#   Installed libmilkgric.so loads automatically via the Milk command catalog.
#   When running from an uninstalled build, load it explicitly first:
#   @module load /path/to/libmilkgric.so
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Training Phase: Datasets A and B (Pre-Synchronized on Filesystem)
# ------------------------------------------------------------------------------
# Datasets A and B are stored on the filesystem (e.g., dataset_A.txt, dataset_B.txt)
# and are pre-synchronized sample-by-sample (row i in A <-> row i in B).
#
# Clustering can be run directly on the filesystem files:
#   gric-cluster 0.35 dataset_A.txt -outdir a_cluster.dat
#   gric-knn dataset_A.txt a_cluster.dat -k 10
#   gric-cluster 0.35 dataset_B.txt -outdir b_cluster.dat
#   gric-knn dataset_B.txt b_cluster.dat -k 10
#
# Or within Milk CLI when loaded into shared memory (e.g., via iofits.loadfits):
# Cluster Training Dataset A (Observation space):
gric.gric_cluster \
    .in_name=demo4_stream_A \
    .out_name=demo4_a_assign \
    .save_dir=a_cluster.dat \
    .max_frames=1000

# Cluster Training Dataset B (Target state space):
gric.gric_cluster \
    .in_name=demo4_stream_B \
    .out_name=demo4_b_assign \
    .save_dir=b_cluster.dat \
    .max_frames=1000

# ------------------------------------------------------------------------------
# 2. Inference Phase: Stream C -> k-NN on A -> Reconstruct D from B
# ------------------------------------------------------------------------------

# Launch Reconstructor asynchronously so it waits for k-NN match frames,
# then run streaming k-NN search against Reference Dataset A:
milkcall --async gric.gric_reconstruct \
    .in_name=demo4_c_matches \
    .target_data=dataset_B.txt \
    .out_name=demo4_stream_D \
    .weight_mode=idw \
    .alpha=1.0 \
    .k=10 \
    .max_frames=200

gric.gric_knn \
    .in_name=demo4_stream_C \
    .out_name=demo4_c_matches \
    .cluster_dir=a_cluster.dat \
    .ref_data=dataset_A.txt \
    .k=10 \
    .max_frames=200
