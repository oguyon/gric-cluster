#!/usr/bin/env bash
# ==============================================================================
#  GRIC Simulator - Desktop Application Launcher
# ==============================================================================
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${GRIC_GUI_PORT:-8080}"
WORKDIR="${DIR}/workspace"
mkdir -p "$WORKDIR"
WINDOW_SIZE="1600,1000"
BROWSER=""
SERVER_ONLY=0
KILL_SERVER=0
CHECK_STATUS=0

# ANSI Color formatting matching shared/cli_colors.h
if [[ -z "${NO_COLOR:-}" && -t 1 ]]; then
    ANSI_BOLD=" [1m"
    ANSI_BOLD_CYAN=" [1;36m"
    ANSI_BOLD_GREEN=" [1;32m"
    ANSI_COLOR_GREEN=" [0;32m"
    ANSI_COLOR_CYAN=" [0;36m"
    ANSI_COLOR_MAGENTA=" [0;35m"
    ANSI_COLOR_YELLOW=" [0;33m"
    ANSI_COLOR_RED=" [0;31m"
    ANSI_COLOR_GREY=" [0;90m"
    ANSI_COLOR_RESET=" [0m"
    COLOR_MODE_STR="Color mode: ON (set NO_COLOR=1 to disable ANSI colors)"
else
    ANSI_BOLD=""
    ANSI_BOLD_CYAN=""
    ANSI_BOLD_GREEN=""
    ANSI_COLOR_GREEN=""
    ANSI_COLOR_CYAN=""
    ANSI_COLOR_MAGENTA=""
    ANSI_COLOR_YELLOW=""
    ANSI_COLOR_RED=""
    ANSI_COLOR_GREY=""
    ANSI_COLOR_RESET=""
    COLOR_MODE_STR="Color mode: OFF (NO_COLOR is set or non-interactive terminal)"
fi

print_help_raw() {
    printf "%bNAME%b\n" "${ANSI_BOLD_CYAN}" "${ANSI_COLOR_RESET}"
    printf "  %bgric-gui%b - Desktop Launcher for the GRIC Interactive Simulator\n\n" \
           "${ANSI_BOLD_GREEN}" "${ANSI_COLOR_RESET}"

    printf "%bSYNOPSIS%b\n" "${ANSI_BOLD_CYAN}" "${ANSI_COLOR_RESET}"
    printf "  %bgric-gui%b %b[options]%b\n\n" \
           "${ANSI_BOLD_GREEN}" "${ANSI_COLOR_RESET}" "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"

    printf "%bDESCRIPTION%b\n" "${ANSI_BOLD_CYAN}" "${ANSI_COLOR_RESET}"
    printf "  Launches the GRIC dual-mode interactive simulator in a native desktop window.\n"
    printf "  Powered by the native C gric-server with full workspace file read/write access\n"
    printf "  and support for both in-browser WASM and native compiled CLI executables\n"
    printf "  (gric-cluster, gric-knn).\n\n"

    printf "%bOPTIONS%b\n" "${ANSI_BOLD_CYAN}" "${ANSI_COLOR_RESET}"
    printf "  %b-h, --help%b                 Show this help message and exit\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}"
    printf "  %b-d, --dir%b %b<path>%b           Working directory (default: \$PWD)\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}" "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b-p, --port%b %b<port>%b           HTTP port (default: 8080 or \$GRIC_GUI_PORT)\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}" "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b-b, --browser%b %b<name>%b       Browser engine (chrome, firefox, default)\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}" "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b-w, --window-size%b %b<W,H>%b   Window resolution (default: 1600,1000)\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}" "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b-s, --server-only%b          Start gric-server without launching browser\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}"
    printf "  %b-k, --kill-server%b          Terminate running background server on port\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}"
    printf "  %b--status%b                   Display server process and browser status\n\n" \
           "${ANSI_COLOR_GREEN}" "${ANSI_COLOR_RESET}"

    printf "%bEXAMPLES%b\n" "${ANSI_BOLD_CYAN}" "${ANSI_COLOR_RESET}"
    printf "  %b# Launch desktop GUI with current directory as workspace:%b\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b$%b %bgric-gui%b\n\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}" "${ANSI_BOLD_GREEN}" "${ANSI_COLOR_RESET}"

    printf "  %b# Launch pointing to a specific workspace directory:%b\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b$%b %bgric-gui%b -d /path/to/my_experiment -p 8088\n\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}" "${ANSI_BOLD_GREEN}" "${ANSI_COLOR_RESET}"

    printf "  %b# Start local gric-server in background only:%b\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b$%b %bgric-gui%b --server-only\n\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}" "${ANSI_BOLD_GREEN}" "${ANSI_COLOR_RESET}"

    printf "  %b# Stop the background gric-server:%b\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}"
    printf "  %b$%b %bgric-gui%b --kill-server\n\n" \
           "${ANSI_COLOR_GREY}" "${ANSI_COLOR_RESET}" "${ANSI_BOLD_GREEN}" "${ANSI_COLOR_RESET}"

    printf "%b%s%b\n" "${ANSI_COLOR_GREY}" "${COLOR_MODE_STR}" "${ANSI_COLOR_RESET}"
}

print_help() {
    if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
        local lines
        lines=$(print_help_raw | wc -l)
        local term_lines
        term_lines=$(tput lines 2>/dev/null || echo 24)
        if [[ $lines -gt $term_lines ]]; then
            print_help_raw | "${PAGER:-less -R}"
            return 0
        fi
    fi
    print_help_raw
}

# Parse command line options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        -d|--dir)
            if [[ -z "${2:-}" || "${2:-}" =~ ^- ]]; then
                echo -e "${ANSI_COLOR_RED}Error: $1 requires directory path.${ANSI_COLOR_RESET}" >&2
                exit 1
            fi
            WORKDIR="$(cd "$2" && pwd)"
            shift 2
            ;;
        -p|--port)
            if [[ -z "${2:-}" || "${2:-}" =~ ^- ]]; then
                echo -e "${ANSI_COLOR_RED}Error: $1 requires port number.${ANSI_COLOR_RESET}" >&2
                exit 1
            fi
            PORT="$2"
            shift 2
            ;;
        -b|--browser)
            if [[ -z "${2:-}" || "${2:-}" =~ ^- ]]; then
                echo -e "${ANSI_COLOR_RED}Error: $1 requires browser name.${ANSI_COLOR_RESET}" >&2
                exit 1
            fi
            BROWSER="$2"
            shift 2
            ;;
        -w|--window-size)
            if [[ -z "${2:-}" || "${2:-}" =~ ^- ]]; then
                echo -e "${ANSI_COLOR_RED}Error: $1 requires W,H size.${ANSI_COLOR_RESET}" >&2
                exit 1
            fi
            WINDOW_SIZE="$2"
            shift 2
            ;;
        -s|--server-only)
            SERVER_ONLY=1
            shift
            ;;
        -k|--kill-server)
            KILL_SERVER=1
            shift
            ;;
        -r|--restart)
            RESTART_SERVER=1
            shift
            ;;
        --status)
            CHECK_STATUS=1
            shift
            ;;
        *)
            echo -e "${ANSI_COLOR_RED}Error: Unknown option '$1'.${ANSI_COLOR_RESET}" >&2
            echo -e "Use '${ANSI_BOLD_GREEN}gric-gui -h${ANSI_COLOR_RESET}' for usage." >&2
            exit 1
            ;;
    esac
done

URL="http://127.0.0.1:${PORT}/visual_simulator.html"

# Handle --kill-server or --restart
if [[ $KILL_SERVER -eq 1 || ${RESTART_SERVER:-0} -eq 1 ]]; then
    # Attempt graceful HTTP shutdown first
    curl -s -m 1 -X POST "http://127.0.0.1:${PORT}/api/shutdown" >/dev/null 2>&1 || true
    sleep 0.2

    PIDS=$(lsof -ti ":${PORT}" 2>/dev/null || \
           ss -tlnp 2>/dev/null | grep ":${PORT} " | grep -o 'pid=[0-9]*' | cut -d= -f2 || true)
    if [[ -n "$PIDS" ]]; then
        echo -e "${ANSI_COLOR_YELLOW}Stopping port ${PORT} processes: ${PIDS}${ANSI_COLOR_RESET}"
        for pid in $PIDS; do
            kill -9 "$pid" 2>/dev/null || true
        done
        sleep 0.2
        echo -e "${ANSI_COLOR_GREEN}Server stopped.${ANSI_COLOR_RESET}"
    else
        echo -e "${ANSI_COLOR_GREEN}Server stopped on port ${PORT}.${ANSI_COLOR_RESET}"
    fi
    if [[ $KILL_SERVER -eq 1 ]]; then
        exit 0
    fi
fi

# Locate gric-server binary
SERVER_BIN=""
if [[ -x "${DIR}/build/gric-server" ]]; then
    SERVER_BIN="${DIR}/build/gric-server"
elif command -v gric-server >/dev/null 2>&1; then
    SERVER_BIN="$(command -v gric-server)"
elif [[ -d "${DIR}/build" ]] && command -v cmake >/dev/null 2>&1; then
    echo -e "${ANSI_COLOR_CYAN}⚡ Compiling native gric-server...${ANSI_COLOR_RESET}"
    cmake --build "${DIR}/build" --target gric-server >/dev/null 2>&1 || true
    if [[ -x "${DIR}/build/gric-server" ]]; then
        SERVER_BIN="${DIR}/build/gric-server"
    fi
fi

# Handle --status
if [[ $CHECK_STATUS -eq 1 ]]; then
    echo -e "\n${ANSI_BOLD_CYAN}GRIC SIMULATOR DESKTOP STATUS${ANSI_COLOR_RESET}"
    if curl -s -m 1 "${URL}" >/dev/null 2>&1; then
        echo -e "  Server Status:   ${ANSI_COLOR_GREEN}● Running${ANSI_COLOR_RESET} (${URL})"
    else
        echo -e "  Server Status:   ${ANSI_COLOR_RED}○ Stopped${ANSI_COLOR_RESET} (Port ${PORT})"
    fi
    if [[ -n "$SERVER_BIN" ]]; then
        echo -e "  gric-server:     ${ANSI_COLOR_GREEN}Available${ANSI_COLOR_RESET} (${SERVER_BIN})"
    else
        echo -e "  gric-server:     ${ANSI_COLOR_YELLOW}Not compiled${ANSI_COLOR_RESET}"
    fi

    echo -e "\n${ANSI_BOLD_CYAN}AVAILABLE BROWSER RUNTIMES${ANSI_COLOR_RESET}"
    for b in google-chrome chromium-browser chromium firefox; do
        if command -v "$b" >/dev/null 2>&1; then
            echo -e "  $b:  ${ANSI_COLOR_GREEN}Available${ANSI_COLOR_RESET} ($(command -v "$b"))"
        else
            echo -e "  $b:  ${ANSI_COLOR_GREY}Not installed${ANSI_COLOR_RESET}"
        fi
    done
    echo ""
    exit 0
fi

# 1. Start gric-server if not already responding with /api/info
SPAWNED_SERVER=0
SERVER_PID=""
if ! ( curl -s -m 1 "http://127.0.0.1:${PORT}/api/info" 2>/dev/null | \
       grep -q '"status"[[:space:]]*:[[:space:]]*"ok"' ); then
    # Kill any stale or rogue non-gric-server processes on the port
    PIDS=$(lsof -ti ":${PORT}" 2>/dev/null || \
           ss -tlnp 2>/dev/null | grep ":${PORT} " | grep -o 'pid=[0-9]*' | cut -d= -f2 || true)
    if [[ -n "$PIDS" ]]; then
        for pid in $PIDS; do
            kill -9 "$pid" 2>/dev/null || true
        done
        sleep 0.3
    fi

    if [[ -z "$SERVER_BIN" ]]; then
        echo -e "${ANSI_COLOR_RED}Error: gric-server binary not found.${ANSI_COLOR_RESET}" >&2
        echo -e "Build: ${ANSI_BOLD_GREEN}cmake --build build${ANSI_COLOR_RESET}" >&2
        exit 1
    fi

    echo -e "${ANSI_COLOR_CYAN}⚡ Starting native gric-server on port ${PORT}...${ANSI_COLOR_RESET}"
    echo -e "  ${ANSI_COLOR_GREY}Workspace: ${WORKDIR}${ANSI_COLOR_RESET}"
    if [[ $SERVER_ONLY -eq 1 ]]; then
        if command -v setsid >/dev/null 2>&1; then
            setsid "$SERVER_BIN" -p "${PORT}" -d "${WORKDIR}" \
                   -w "${DIR}/docs" >/tmp/gric_server.log 2>&1 &
            SERVER_PID=$!
        else
            nohup "$SERVER_BIN" -p "${PORT}" -d "${WORKDIR}" \
                  -w "${DIR}/docs" >/tmp/gric_server.log 2>&1 &
            SERVER_PID=$!
        fi
    else
        "$SERVER_BIN" -p "${PORT}" -d "${WORKDIR}" -w "${DIR}/docs" \
            --watch-pid $$ --idle-timeout 10 --auto-shutdown >/tmp/gric_server.log 2>&1 &
        SERVER_PID=$!
        SPAWNED_SERVER=1
    fi
    
    # Wait up to 2.5s for server to become responsive
    SERVER_OK=0
    for ((i=0; i<25; i++)); do
        sleep 0.1
        if curl -s -m 1 "http://127.0.0.1:${PORT}/api/info" 2>/dev/null | \
           grep -q '"status"[[:space:]]*:[[:space:]]*"ok"'; then
            SERVER_OK=1
            break
        fi
    done

    if [[ $SERVER_OK -eq 0 ]]; then
        echo -e "${ANSI_COLOR_RED}Error: Failed to start server on ${PORT}.${ANSI_COLOR_RESET}" >&2
        if [[ -f /tmp/gric_server.log ]]; then
            cat /tmp/gric_server.log >&2
        fi
        exit 1
    fi
fi

if [[ $SERVER_ONLY -eq 1 ]]; then
    echo -e "${ANSI_COLOR_GREEN}✅ gric-server running at ${URL}${ANSI_COLOR_RESET}"
    echo -e "  ${ANSI_COLOR_CYAN}Workspace directory: ${WORKDIR}${ANSI_COLOR_RESET}"
    exit 0
fi

# Set up process exit trap to ensure gric-server terminates when GUI window closes
cleanup_gui() {
    local exit_code=$?
    if [[ "${SPAWNED_SERVER:-0}" -eq 1 && -n "${SERVER_PID:-}" ]] && \
       kill -0 "$SERVER_PID" 2>/dev/null; then
        echo -e "\n${ANSI_COLOR_YELLOW}🛑 Stopping gric-server (${SERVER_PID})...${ANSI_COLOR_RESET}"
        curl -s -m 1 -X POST "http://127.0.0.1:${PORT}/api/shutdown" >/dev/null 2>&1 || true
        sleep 0.1
        if kill -0 "$SERVER_PID" 2>/dev/null; then
            kill -TERM "$SERVER_PID" 2>/dev/null || true
        fi
    fi
    exit $exit_code
}
trap cleanup_gui EXIT INT TERM HUP

# 2. Launch Browser / Desktop App Window
echo -e "${ANSI_COLOR_GREEN}Launching GRIC Simulator (${URL})...${ANSI_COLOR_RESET}"

GUI_PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gric-gui"
mkdir -p "${GUI_PROFILE_DIR}"

CHROME_FLAGS=(
    "--app=${URL}"
    "--window-size=${WINDOW_SIZE}"
    "--user-data-dir=${GUI_PROFILE_DIR}/chrome-profile"
    "--no-first-run"
    "--no-default-browser-check"
)

CHROMIUM_FLAGS=(
    "--app=${URL}"
    "--window-size=${WINDOW_SIZE}"
    "--user-data-dir=${GUI_PROFILE_DIR}/chromium-profile"
    "--no-first-run"
    "--no-default-browser-check"
)

run_browser_and_wait() {
    local start_ts
    start_ts=$(date +%s)

    "$@"
    local browser_exit=$?

    local elapsed
    elapsed=$(( $(date +%s) - start_ts ))

    # If the browser command returned immediately (e.g. attached to an existing session),
    # keep the script alive so gric-server remains running until interrupted.
    if [[ $elapsed -lt 2 && -n "${SERVER_PID:-}" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
        echo -e "${ANSI_COLOR_CYAN}Simulator is running at ${URL}${ANSI_COLOR_RESET}"
        echo -e "${ANSI_COLOR_GREY}Press Ctrl+C to stop the server.${ANSI_COLOR_RESET}"
        wait "$SERVER_PID" 2>/dev/null || sleep infinity
    fi
    return $browser_exit
}

if [[ -n "$BROWSER" ]]; then
    case "$BROWSER" in
        google-chrome|chrome)
            run_browser_and_wait google-chrome "${CHROME_FLAGS[@]}"
            ;;
        chromium|chromium-browser)
            if command -v chromium >/dev/null 2>&1; then
                run_browser_and_wait chromium "${CHROMIUM_FLAGS[@]}"
            elif command -v chromium-browser >/dev/null 2>&1; then
                run_browser_and_wait chromium-browser "${CHROMIUM_FLAGS[@]}"
            else
                echo -e "${ANSI_COLOR_RED}Error: Chromium browser not found.${ANSI_COLOR_RESET}" >&2
                exit 1
            fi
            ;;
        brave|brave-browser)
            run_browser_and_wait brave-browser "${CHROMIUM_FLAGS[@]}"
            ;;
        edge|msedge|microsoft-edge)
            run_browser_and_wait microsoft-edge "${CHROMIUM_FLAGS[@]}"
            ;;
        firefox)
            run_browser_and_wait firefox --new-window "${URL}"
            ;;
        default)
            xdg-open "${URL}" >/dev/null 2>&1 || true
            echo -e "${ANSI_COLOR_CYAN}Simulator is running at ${URL}${ANSI_COLOR_RESET}"
            echo -e "${ANSI_COLOR_GREY}Press Ctrl+C to stop the server.${ANSI_COLOR_RESET}"
            wait "$SERVER_PID" 2>/dev/null || sleep infinity
            ;;
        *)
            if command -v "$BROWSER" >/dev/null 2>&1; then
                run_browser_and_wait "$BROWSER" "${URL}"
            else
                echo -e "${ANSI_COLOR_RED}Error: '$BROWSER' not found.${ANSI_COLOR_RESET}" >&2
                exit 1
            fi
            ;;
    esac
elif command -v google-chrome >/dev/null 2>&1; then
    run_browser_and_wait google-chrome "${CHROME_FLAGS[@]}"
elif command -v chromium >/dev/null 2>&1; then
    run_browser_and_wait chromium "${CHROMIUM_FLAGS[@]}"
elif command -v chromium-browser >/dev/null 2>&1; then
    run_browser_and_wait chromium-browser "${CHROMIUM_FLAGS[@]}"
elif command -v firefox >/dev/null 2>&1; then
    run_browser_and_wait firefox --new-window "${URL}"
else
    xdg-open "${URL}" >/dev/null 2>&1 || true
    echo -e "${ANSI_COLOR_CYAN}Simulator is running at ${URL}${ANSI_COLOR_RESET}"
    echo -e "${ANSI_COLOR_GREY}Press Ctrl+C to stop the server.${ANSI_COLOR_RESET}"
    wait "$SERVER_PID" 2>/dev/null || sleep infinity
fi
