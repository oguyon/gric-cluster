SHELL := /bin/bash

EMSCRIPTEN_ENV ?= $(HOME)/emsdk/emsdk_env.sh

CC = emcc

GIT_HASH := $(shell git describe --always --dirty 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo "unknown")
BUILD_DATE := $(shell date "+%b %d %Y %H:%M:%S")

CFLAGS = -O3 -msimd128 -DGRIC_GIT_HASH="\"$(GIT_HASH)\"" -DGRIC_BUILD_DATE="\"$(BUILD_DATE)\""

INCLUDES = \
	-Isrc \
	-Isrc/gric-cluster/core \
	-Isrc/gric-cluster/math \
	-Isrc/gric-cluster/steps \
	-Isrc/gric-cluster/io \
	-Isrc/gric-cluster/trace \
	-Isrc/gric-knn \
	-Isrc/wasm

SRCS = \
	src/gric-cluster/math/framedistance.c \
	src/gric-cluster/math/cluster_math.c \
	src/gric-cluster/math/cluster_prune.c \
	src/gric-cluster/math/cluster_scandist.c \
	src/gric-cluster/math/tuple_retrieval.c \
	src/gric-cluster/core/cluster_step.c \
	src/gric-cluster/core/cluster_mgmt.c \
	src/gric-cluster/core/cluster_bounds.c \
	src/gric-cluster/core/tile_map.c \
	src/gric-cluster/core/tile_state.c \
	src/gric-cluster/io/frame_scatter.c \
	src/gric-cluster/steps/initialize_initial_cluster.c \
	src/gric-cluster/steps/compute_priors_and_mixing.c \
	src/gric-cluster/steps/select_next_measurement_target.c \
	src/gric-cluster/steps/measure_distance_to_cluster.c \
	src/gric-cluster/steps/update_probabilities_and_pruning.c \
	src/gric-cluster/steps/update_geometric_probabilities.c \
	src/gric-cluster/steps/handle_new_cluster_creation.c \
	src/gric-cluster/steps/record_step_assignment.c \
	src/gric-cluster/steps/update_consistency_mask.c \
	src/gric-cluster/trace/cluster_trace.c \
	src/gric-knn/knn_heap.c \
	src/gric-knn/knn_reader.c \
	src/gric-knn/knn_engine.c \
	src/wasm/gric_wasm_api.c

OUT_DIR_SITE = site/simulator/wasm
OUT_DIR_DOCS = docs/simulator/wasm
OUT_FILE_SITE = $(OUT_DIR_SITE)/gric_cluster.js

EXPORTED_FUNCTIONS = "['_wasm_cluster_init','_wasm_cluster_process_frame','_wasm_cluster_process_batch','_wasm_cluster_get_num_clusters','_wasm_cluster_get_anchors','_wasm_cluster_get_dcc','_wasm_cluster_get_transition_matrix','_wasm_cluster_get_telemetry','_wasm_cluster_get_probs','_wasm_cluster_get_evaluations','_wasm_cluster_reset','_wasm_cluster_free','_wasm_cluster_set_trace','_wasm_cluster_get_trace_count','_wasm_cluster_get_trace_events','_wasm_cluster_get_trace_event_size','_wasm_cluster_get_trace_head','_wasm_cluster_get_trace_frame_start','_wasm_cluster_clear_trace','_wasm_cluster_set_unlimited','_wasm_cluster_get_capacity','_wasm_cluster_get_version','_wasm_multitile_init','_wasm_multitile_process_frame','_wasm_multitile_get_num_tile_clusters','_wasm_multitile_get_tile_clusters','_wasm_multitile_get_tuples','_wasm_multitile_get_tile_telemetry','_wasm_multitile_get_num_tiles','_wasm_multitile_reset','_wasm_multitile_free','_wasm_knn_run_search','_malloc','_free']"
EXPORTED_RUNTIME_METHODS = "['ccall','cwrap','getValue','setValue','HEAPF64','HEAP32','HEAPU8']"

LDFLAGS = \
	-s MODULARIZE=1 \
	-s EXPORT_NAME='GricClusterModule' \
	-s EXPORTED_FUNCTIONS=$(EXPORTED_FUNCTIONS) \
	-s EXPORTED_RUNTIME_METHODS=$(EXPORTED_RUNTIME_METHODS) \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s INITIAL_MEMORY=16777216 \
	-s STACK_SIZE=1048576 \
	--no-entry

.PHONY: all clean dirs $(OUT_FILE_SITE)

all: dirs $(OUT_FILE_SITE)
	@mkdir -p $(OUT_DIR_DOCS)
	@cp -f $(OUT_DIR_SITE)/gric_cluster.js $(OUT_DIR_DOCS)/gric_cluster.js
	@cp -f $(OUT_DIR_SITE)/gric_cluster.wasm $(OUT_DIR_DOCS)/gric_cluster.wasm
	@echo "⚡ [WASM] Built & deployed: $(GIT_HASH) | $(BUILD_DATE)"

$(OUT_FILE_SITE): $(SRCS)
	if [ -f "$(EMSCRIPTEN_ENV)" ]; then source "$(EMSCRIPTEN_ENV)"; fi && \
	$(CC) $(CFLAGS) $(INCLUDES) $(SRCS) -o $(OUT_FILE_SITE) $(LDFLAGS)

dirs:
	mkdir -p $(OUT_DIR_SITE) $(OUT_DIR_DOCS)

clean:
	rm -rf $(OUT_DIR_SITE)
	rm -f $(OUT_DIR_DOCS)/gric_cluster.js $(OUT_DIR_DOCS)/gric_cluster.wasm

